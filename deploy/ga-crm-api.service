# systemd unit of the API. Install: deploy/README.md, step 5.
[Unit]
Description=GA CRM API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=gacrm
Group=gacrm
# `current` points at the live release; the API reads /opt/ga-crm/.env through it
WorkingDirectory=/opt/ga-crm/current/backend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
# Nest closes the database pool and sockets on SIGTERM (enableShutdownHooks)
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening: the API only writes to nowhere on disk; chat files go to MinIO / S3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/ga-crm

[Install]
WantedBy=multi-user.target
