# Run `npm run setup:env` to create .env; every __GENERATE__ value is replaced with a random string.

NODE_ENV=development
# Frontend origin: used for invite links and the CSRF origin check (USER-10)
APP_URL=http://localhost:5173

# Session lifetime, renewed while the user stays active (USER-9)
SESSION_TTL_DAYS=7
# Hard limit of a session, however active the user stays
SESSION_MAX_DAYS=30

# Reverse proxies in front of the API (0 = none). Wrong values break IP rate limits: too low counts
# everyone as the proxy's IP, too high lets clients fake their IP with X-Forwarded-For.
TRUST_PROXY_HOPS=0

# First Platform Admin, created only when none exists
PLATFORM_ADMIN_EMAIL=platform@gacrm.local
PLATFORM_ADMIN_PASSWORD=__GENERATE__
PLATFORM_ADMIN_NAME=Quản trị nền tảng

# MFA (USER-16): encrypts each user's TOTP secret; changing it makes everyone set MFA up again.
MFA_KEYS_SECRET=__GENERATE__
# "false" stops forcing MFA on GA_HEAD, ADMIN and PLATFORM_ADMIN (local demos only)
MFA_ENFORCE=true
# Account switcher for testing roles quickly (header and sign-in page list every account; no password).
# Local testing only: the API refuses to start with it on when NODE_ENV=production.
DEV_ACCOUNT_SWITCHER=false

# AI (section 14.4). Encrypts each GA's provider keys (AI-15); changing it makes saved keys unreadable.
AI_KEYS_SECRET=__GENERATE__
# Optional platform keys, used when a GA has not entered its own (AI-15)
AI_PLATFORM_KEY_GEMINI=
AI_PLATFORM_KEY_DEEPSEEK=
AI_PLATFORM_KEY_QWEN=

# Public lead form (CMP-4): Cloudflare Turnstile keys. Empty: no check in development, forms off in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostgreSQL: target database of backend (docs/thiet-ke-he-thong.md). Port 5433 in case another
# PostgreSQL already uses 5432. The owner runs migrations; the API connects as crm_app (row-level
# security applies) and crm_platform (cross-tenant lookups only, TEN-6).
PG_PORT=5433
PG_DB=ga_crm
PG_OWNER_USER=crm_owner
PG_OWNER_PASSWORD=__GENERATE__
PG_APP_PASSWORD=__GENERATE__
PG_PLATFORM_PASSWORD=__GENERATE__
DATABASE_URL=postgres://crm_app:${PG_APP_PASSWORD}@localhost:${PG_PORT}/${PG_DB}
DATABASE_PLATFORM_URL=postgres://crm_platform:${PG_PLATFORM_PASSWORD}@localhost:${PG_PORT}/${PG_DB}
DATABASE_OWNER_URL=postgres://${PG_OWNER_USER}:${PG_OWNER_PASSWORD}@localhost:${PG_PORT}/${PG_DB}
# The API (backend); the frontend's dev proxy sends /api here
API_PORT=4200

# Redis / Valkey (docker compose service valkey). Carries realtime events between API instances.
# Empty: events stay inside one API process, which is enough for one instance. Required in production.
REDIS_PORT=6380
REDIS_URL=redis://localhost:${REDIS_PORT}

# Object storage (S3 API) for chat files. Development: the minio service of docker-compose.
# Production: a real S3 bucket (leave S3_ENDPOINT empty, set S3_REGION). Required in production.
S3_PORT=9100
S3_ENDPOINT=http://localhost:${S3_PORT}
S3_REGION=us-east-1
S3_BUCKET=ga-crm
S3_ACCESS_KEY_ID=crm_storage
S3_SECRET_ACCESS_KEY=__GENERATE__
